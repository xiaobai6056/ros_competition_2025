<?xml version="1.0"?>
<launch>
    <!-- 启动板子检测导航节点 -->
    <node name="board_detection_navigator" pkg="test_pkg" type="board_detection_navigator" output="screen">
        <!-- 聚类参数 -->
        <param name="board_detection/max_distance_jump" value="0.12" />
        <param name="board_detection/min_valid_range" value="0.1" />
        <param name="board_detection/max_valid_range" value="4.0" />
        <param name="board_detection/min_cluster_size" value="8" />
        <param name="board_detection/max_cluster_size" value="100" />
        
        <!-- 过滤参数 -->
        <param name="board_detection/min_board_length" value="0.2" />
        <param name="board_detection/max_board_length" value="0.9" />
        <param name="board_detection/max_angular_width" value="0.4" />
        <param name="board_detection/duplicate_distance" value="0.3" />
        
        <!-- 安全距离参数 -->
        <param name="board_detection/default_safe_distance" value="0.7" />
        <param name="board_detection/extended_safe_distance" value="1.0" />
        <param name="board_detection/waypoint_switch_distance" value="0.8" />
    </node>
</launch>